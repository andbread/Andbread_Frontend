# 로컬 개발과 테스트용 환경 변수 목록입니다.
# 이 파일을 .env.local로 복사한 뒤 값을 채웁니다. 실제 값은 커밋하지 않습니다.
#
# Next.js와 e2e/fixtures/env.ts는 .env와 .env.local을 함께 읽고, 같은 키는 .env.local 값을 씁니다.
# .env.local에 없는 키는 .env 값으로 채워지므로 Supabase 항목은 아래 네 개를 모두 .env.local에 적습니다.

# ---------------------------------------------------------------------------
# Supabase (필수)
# E2E와 Route Handler 통합 테스트는 이 프로젝트에 사용자와 그룹을 만들고 지웁니다.
# 반드시 운영과 분리된 개발 프로젝트 값을 넣습니다.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
# 브라우저 클라이언트(src/lib/supabaseClient.ts)가 씁니다.
NEXT_PUBLIC_SUPABASE_KEY=
# Route Handler 클라이언트(src/app/api/_lib/supabaseRouteClient.ts)는 이 값을 먼저 읽습니다.
# 비워 두면 .env의 값이 쓰여 URL과 키의 프로젝트가 어긋날 수 있으므로 위 키와 같은 개발 프로젝트 값을 넣습니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용입니다. 회원 탈퇴 Route Handler와 테스트 seed, cleanup이 씁니다. 브라우저 코드로 넘기지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 테스트 (E2E, Route Handler 통합 테스트)
# ---------------------------------------------------------------------------
# 테스트가 직접 만들고 지우는 계정에만 쓰는 비밀번호입니다. 비어 있으면 데이터가 필요한 케이스를 건너뜁니다.
E2E_TEST_USER_PASSWORD=
# 이미 떠 있는 서버를 대상으로 E2E를 돌릴 때만 넣습니다. 비우면 Playwright가 npm run dev를 띄웁니다.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# 사이트 주소
# ---------------------------------------------------------------------------
# 로그인 후 돌아올 주소(src/lib/auth.ts)입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 초대 링크를 만들 때 쓰는 주소(src/lib/nbread/insertLink.ts)입니다.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Sentry
# 로컬 E2E나 성능 측정용으로 빌드할 때는 DSN을 비웁니다. 빌드 시점에 번들에 들어가므로 실행할 때 비우면 적용되지 않습니다.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
SENTRY_ENVIRONMENT=local
# 소스맵 업로드용입니다. 로컬에서는 비워 둡니다.
SENTRY_AUTH_TOKEN=
# Sentry 웹훅을 Discord로 전달하는 Route Handler(src/app/api/sentry-webhook/route.ts)가 씁니다.
SENTRY_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Firebase 푸시 알림 (알림 기능을 확인할 때만 필요합니다)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# 외부 서비스 (선택)
# ---------------------------------------------------------------------------
# 초대 링크 카카오톡 공유에 씁니다.
NEXT_PUBLIC_KAKAO_APP_KEY=
# 로컬에서는 비워 두어 운영 수집 데이터에 섞이지 않게 합니다.
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
